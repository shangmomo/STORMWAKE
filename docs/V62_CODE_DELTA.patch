+// optical depth of one exponential layer from height hc along a ray with direction y component
+// vy over distance d
+fn hazeLayerDepth( sigma: f32, H: f32, hc: f32, vy: f32, d: f32 ) -> f32 {
+	let base = exp( hc / - H ) * sigma;
+	let k = vy * d / H;
